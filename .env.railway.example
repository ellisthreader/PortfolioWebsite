APP_NAME="Ellis Threader"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app.up.railway.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=info
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter

DB_CONNECTION=pgsql
DB_URL=${{Postgres.DATABASE_URL}}
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Contact form delivery. Without these, messages are only written to the log.
# Resend over SMTP (free tier): verify ellisthreader.com in Resend, then use an API key as the password.
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@ellisthreader.com"
MAIL_FROM_NAME="${APP_NAME}"
# Or Gmail with an app password (Google account > Security > App passwords):
# MAIL_HOST=smtp.gmail.com
# MAIL_USERNAME=ellis.threader3001@gmail.com
# MAIL_FROM_ADDRESS="ellis.threader3001@gmail.com"

# Portfolio links. Leave empty to hide them.
PORTFOLIO_LINKEDIN_URL=https://www.linkedin.com/in/ellis-threader-25036b320
PORTFOLIO_CV_PATH=
PORTFOLIO_AVAILABLE=true


# Railway/Railpack: install PostgreSQL support for Laravel's pgsql driver.
RAILPACK_PHP_EXTENSIONS=pgsql,pdo_pgsql
